<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle. Merged with the keys generated from build settings (GENERATE_INFOPLIST_FILE). -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/chris2cant/timi/main/appcast.xml</string>
	<!-- Output of scripts/generate-keys.sh. The private key stays in the macOS Keychain, never in Git. -->
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_generate_keys_OUTPUT</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Never install without the user's interaction. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<!-- Appcast and release notes must be EdDSA-signed; archive signature is verified before extraction. -->
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
